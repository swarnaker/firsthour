# RPC Configuration (optional)
# If not set, the app will use catalog-only mode
ROBINHOOD_RPC_URL=

# Admin Authentication
# Default credentials are admin/admin if not set
ADMIN_USER=admin
ADMIN_PASSWORD=admin

# Telegram Alerts (optional)
# Get bot token from @BotFather on Telegram
TELEGRAM_BOT_TOKEN=

# Get your chat ID from @userinfobot or similar
TELEGRAM_CHAT_ID=

# Cron Security (optional)
# If set, the /api/cron/notify endpoint will require this secret
# Pass as Authorization: Bearer {CRON_SECRET}
CRON_SECRET=
